<?xml version="1.0" encoding="UTF-8"?>
<!--
  Survey figure for SURVEY.md §10: Formalized Scientific Publication Authoring,
  the loop for ONE mathematical result. Not a declared, executable process of
  this layer: the executable pieces are this layer's authoring and review
  processes and the science layer's Lean lifecycle.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_FSPA"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:collaboration id="Collaboration_FSPA">
    <bpmn:participant id="Participant_FSPA" name="Formalized Scientific Publication Authoring — one result" processRef="Process_FSPA"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_FSPA" name="Formalized Scientific Publication Authoring" isExecutable="false">
    <bpmn:documentation>One mathematical result, from intent to merge. The result is a triple (narrative statement, narrative proof, Lean). Mechanical checks run first; independent agents then translate each side blind and judge semantic equivalence. A finding returns the block to the authoring agent; a result that cannot be closed is kept as a conjecture or a cited gap. Only the author merges.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_FSPA">
      <bpmn:lane id="Lane_Author" name="Author">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StateIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Authoring agent">
        <bpmn:flowNodeRef>Task_PriorWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftTriple</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Closable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordGap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenPR</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mechanical" name="Mechanical checks">
        <bpmn:flowNodeRef>Task_Mechanical</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Validators" name="Independent validating agents">
        <bpmn:flowNodeRef>Task_BlindTranslate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Equivalence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Green</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Result intended"/>
    <bpmn:userTask id="Task_StateIntent" name="State the result and its sources"/>
    <bpmn:task id="Task_PriorWork" name="Search folio and library for prior work"/>
    <bpmn:task id="Task_DraftTriple" name="Draft narrative statement, narrative proof, Lean"/>
    <bpmn:serviceTask id="Task_Mechanical" name="Schema, references, render, Lean, vacuity, witnesses"/>
    <bpmn:task id="Task_BlindTranslate" name="Translate Lean to prose and prose to Lean, each blind"/>
    <bpmn:task id="Task_Equivalence" name="Judge semantic equivalence; adversarial review"/>
    <bpmn:exclusiveGateway id="Gateway_Green" name="All checks green?"/>
    <bpmn:exclusiveGateway id="Gateway_Closable" name="Can the finding be closed?"/>
    <bpmn:task id="Task_RecordGap" name="Keep as conjecture or cited gap"/>
    <bpmn:task id="Task_OpenPR" name="Open pull request with staging preview"/>
    <bpmn:userTask id="Task_Merge" name="Review and merge"/>
    <bpmn:endEvent id="End" name="Result published"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Task_StateIntent"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_StateIntent" targetRef="Task_PriorWork"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_PriorWork" targetRef="Task_DraftTriple"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_DraftTriple" targetRef="Task_Mechanical"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Mechanical" targetRef="Task_BlindTranslate"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_BlindTranslate" targetRef="Task_Equivalence"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Equivalence" targetRef="Gateway_Green"/>
    <bpmn:sequenceFlow id="F8" name="yes" sourceRef="Gateway_Green" targetRef="Task_OpenPR"/>
    <bpmn:sequenceFlow id="F9" name="no" sourceRef="Gateway_Green" targetRef="Gateway_Closable"/>
    <bpmn:sequenceFlow id="F10" name="yes" sourceRef="Gateway_Closable" targetRef="Task_DraftTriple"/>
    <bpmn:sequenceFlow id="F11" name="no" sourceRef="Gateway_Closable" targetRef="Task_RecordGap"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Task_RecordGap" targetRef="Task_Mechanical"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Task_OpenPR" targetRef="Task_Merge"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Merge" targetRef="End"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_FSPA">
    <bpmndi:BPMNPlane id="Plane_FSPA" bpmnElement="Collaboration_FSPA">
      <bpmndi:BPMNShape id="Participant_FSPA_di" bpmnElement="Participant_FSPA" isHorizontal="true"><dc:Bounds x="0" y="0" width="1330" height="560"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Author_di" bpmnElement="Lane_Author" isHorizontal="true"><dc:Bounds x="30" y="0" width="1300" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true"><dc:Bounds x="30" y="140" width="1300" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Mechanical_di" bpmnElement="Lane_Mechanical" isHorizontal="true"><dc:Bounds x="30" y="280" width="1300" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Validators_di" bpmnElement="Lane_Validators" isHorizontal="true"><dc:Bounds x="30" y="420" width="1300" height="140"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="70" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StateIntent_di" bpmnElement="Task_StateIntent"><dc:Bounds x="140" y="30" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PriorWork_di" bpmnElement="Task_PriorWork"><dc:Bounds x="140" y="170" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DraftTriple_di" bpmnElement="Task_DraftTriple"><dc:Bounds x="300" y="170" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Mechanical_di" bpmnElement="Task_Mechanical"><dc:Bounds x="460" y="310" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BlindTranslate_di" bpmnElement="Task_BlindTranslate"><dc:Bounds x="620" y="450" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Equivalence_di" bpmnElement="Task_Equivalence"><dc:Bounds x="780" y="450" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Green_di" bpmnElement="Gateway_Green" isMarkerVisible="true"><dc:Bounds x="945" y="465" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Closable_di" bpmnElement="Gateway_Closable" isMarkerVisible="true"><dc:Bounds x="945" y="185" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordGap_di" bpmnElement="Task_RecordGap"><dc:Bounds x="780" y="170" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenPR_di" bpmnElement="Task_OpenPR"><dc:Bounds x="1040" y="170" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Merge_di" bpmnElement="Task_Merge"><dc:Bounds x="1040" y="30" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="1220" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="106" y="70"/><di:waypoint x="140" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="200" y="110"/><di:waypoint x="200" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="260" y="210"/><di:waypoint x="300" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="420" y="210"/><di:waypoint x="440" y="210"/><di:waypoint x="440" y="350"/><di:waypoint x="460" y="350"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="580" y="350"/><di:waypoint x="600" y="350"/><di:waypoint x="600" y="490"/><di:waypoint x="620" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="740" y="490"/><di:waypoint x="780" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="900" y="490"/><di:waypoint x="945" y="490"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="995" y="490"/><di:waypoint x="1100" y="490"/><di:waypoint x="1100" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="970" y="465"/><di:waypoint x="970" y="235"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="970" y="185"/><di:waypoint x="970" y="155"/><di:waypoint x="360" y="155"/><di:waypoint x="360" y="170"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="945" y="210"/><di:waypoint x="900" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="840" y="250"/><di:waypoint x="840" y="330"/><di:waypoint x="580" y="330"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="1100" y="170"/><di:waypoint x="1100" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="1160" y="70"/><di:waypoint x="1220" y="70"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
