      "narrative": [
        {
          "text": "Closing quick guide for the ORCID-bulk-push script. It synchronises every queued ORCID entity so DSpace stays up to date with ORCID, retries failures up to the maximum, and -f forces synchronisation of entities that have already failed too often.",
          "lang": "en",
