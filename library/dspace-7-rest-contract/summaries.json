      "narrative": [
        {
          "text": "How the process-cleaner script works. It finds processes in the chosen states and deletes them from the database. By default it deletes COMPLETED processes; -r adds RUNNING ones and -f adds FAILED ones.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
          },
          "drafted_at": "2026-11-01"
        }
      ]
    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s537-parameters",
      "source": "sections/s537-parameters.md",
      "source_hash": "ca86a25aefaf9ff70849455ba76c458dd5305b0f9ae536cae2eb8d002fd765b0",
      "narrative": [
        {
          "text": "Parameters of the process-cleaner script: -h/--help, -r/--running to delete RUNNING processes, -f/--failed to delete FAILED processes, and -c/--completed to delete COMPLETED processes, which is the default when no status is given.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
          },
          "drafted_at": "2026-11-01"
        }
      ]
