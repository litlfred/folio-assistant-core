      "source_hash": "b7d7cde681800eb0eb28b00a5adad8e79c3fc9d5d5d60ec0b2d5e3bc6f29da2f",
      "narrative": [
        {
          "text": "Replacing a file access condition swaps it for a new one whose settings must be valid for its name in the submissionuploads configuration; the example sets an embargo with a start date at index 0. The backend removes the old policy and creates a new one; the text says this works only when the old and new conditions need the same settings (as openaccess and administrator do), and otherwise the request fails with 422.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
