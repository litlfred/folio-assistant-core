    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s757-item",
      "source": "sections/s757-item.md",
      "source_hash": "794e4216fdf2a0e19874d2dac59dbcebd9eb15a2eed639228ad71d95b6d58e6c",
      "narrative": [
        {
          "text": "/api/submission/workspaceitems/<id>/item is read-only and returns the backend item held by the submission. The item cannot be replaced once the submission exists; changes to it show up in the submission automatically but are not checked by submission validation, as they are administrative edits. The example is still to be provided.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
          },
          "drafted_at": "2026-11-01"
        }
      ]
    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s758-submissiondefinition",
      "source": "sections/s758-submissiondefinition.md",
      "source_hash": "b62f20ca52b1a527db02332e264db77a23037c9bd59a6780a6a443ce61a68906",
      "narrative": [
        {
          "text": "/api/submission/workspaceitems/<id>/submissionDefinition is read-only and returns the submission definition used by the in-progress submission, which by default is derived from its collection and follows any change of collection. The same definition can be had from /api/config/submissiondefinitions/search/findByCollection, but this link saves a separate call and leaves room to change the one-to-one link between collections and definitions later without breaking clients. The example is still to be provided.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
          },
          "drafted_at": "2026-11-01"
        }
      ]
