      "source": "sections/s257-single-feature.md",
      "source_hash": "649ce1f45235e6571c6c74befa84b9617541a45a5bac919fb737b8807bad025b",
      "narrative": [
        {
          "text": "GET /api/authz/features/<id> returns one feature, administrators only. The response carries an id (a unique short name), a human-readable description, and resourcetypes, the category.model types (singular, e.g. core.item) it applies to. Codes: 200, 401, 403, and 404 if the feature does not exist.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "claude-opus-5-5",
            "session": "https://claude.ai/code/session_01Qmmkt7RqsTp9ABmR5SJCth"
          },
          "drafted_at": "2026-11-01"
        }
      ]
    },
