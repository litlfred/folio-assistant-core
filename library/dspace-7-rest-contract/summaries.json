      "source_hash": "eaeb694a96a5ccfd17dce122d7abc8bcf104ced23647c9544da9ce4948278bad",
      "narrative": [
        {
          "text": "Specifies GET /api/core/bitstreamformats to list the registry's bitstream formats and an admin-only POST that creates one from JSON giving descriptions, mimetype, support level, internal flag and extensions, returning 201, or 400 for an invalid support level.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "claude-opus-5-5",
