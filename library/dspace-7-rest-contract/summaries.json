      "source_hash": "a820e10e23135bb3252f7fe70363c20c0b6024966f5087adec5942eb540ea740",
      "narrative": [
        {
          "text": "How the subscription-send script works. It runs periodically (for example daily) on the server, finds the users subscribed to communities, collections or items, and sends an email notification for each subscription. Its frequency parameter sets how often notifications go out; for example W sends them once a week.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
