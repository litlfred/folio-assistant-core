    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s256-main-endpoint",
      "source": "sections/s256-main-endpoint.md",
      "source_hash": "88d775c29b8fe3fd3fedfe0244175ac635b89c0ec418defc7d622d7b50d968aa",
      "narrative": [
        {
          "text": "GET /api/authz/features lists every feature in the system, paginated. Only system administrators may call it: 200 on success, 401 if not authenticated, 403 without administrator rights.",
