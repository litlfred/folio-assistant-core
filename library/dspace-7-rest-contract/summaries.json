      "narrative": [
        {
          "text": "The ORCID-bulk-push script is used to make sure every entity in the ORCID queue is synchronised, including ones whose earlier synchronisation failed.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
