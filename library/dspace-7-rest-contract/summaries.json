      "narrative": [
        {
          "text": "GET /api/core/items/search/findEditAuthorized returns the items the current user may edit, paginated. An optional query filters by metadata and also acts as a prefix query, for autosuggest. Codes: 200, 401.",
          "lang": "en",
          "state": "draft",
