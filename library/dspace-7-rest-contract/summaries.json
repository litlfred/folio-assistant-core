      "source_hash": "26d243fd109b64c783bd0ec0b475eaf3071890d5378a73bd878dc579fd34fbe9",
      "narrative": [
        {
          "text": "Heading for the linked entities of a workspace item.",
          "lang": "en",
          "state": "draft",
