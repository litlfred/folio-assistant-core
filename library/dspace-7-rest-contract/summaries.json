    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s761-get-single-workspace-item-from-item-uuid",
      "source": "sections/s761-get-single-workspace-item-from-item-uuid.md",
      "source_hash": "13c8036a3acad9554a2be950943d6fd55d8a3452e96d51b6562aed47c0bce4e6",
      "narrative": [
        {
          "text": "Search method item, /api/submission/workspaceitems/search/item?uuid=<item-uuid>, returns the workspace item for an item; uuid is mandatory, and since an item has at most one workspace item, the result is a single object, not a list. Responses: 200 OK with the workspace item; 401 if not authenticated; 403 without permission to view it; 204 if there is none.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
          },
          "drafted_at": "2026-11-01"
        }
      ]
    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s762-delete-method",
      "source": "sections/s762-delete-method.md",
      "source_hash": "282ffbb2acf818818742009b304eb00827c77627c8aecb93eafe4a70daedf0f8",
      "narrative": [
        {
          "text": "DELETE /api/submission/workspaceitems/<uuid> deletes the workspace item and its associated item. Responses: 204 No content; 401 if not authenticated; 403 unless the requester is the submitter or an administrator; 404 if it does not exist.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
