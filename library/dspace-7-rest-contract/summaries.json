    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s540-what-it-does",
      "source": "sections/s540-what-it-does.md",
      "source_hash": "b6b4a65af4b76125484a1229b54a533ee0445a849eba79e3353dbec4db8dba23",
      "narrative": [
        {
          "text": "The retry-tracker script retries failed commits to the OpenURLTracker, which records requests DSpace makes to external systems (such as DOI lookup services) and stores metadata about them in the database. The script is also used when exchanging usage statistics with IRUS.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
          },
          "drafted_at": "2026-11-01"
        }
      ]
    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s541-who-can-use-it",
      "source": "sections/s541-who-can-use-it.md",
      "source_hash": "feb6950410c85ca0aa0b3cf2ba7c4e5a7c2577b0be213ab97fe20faa19cf6b5b",
      "narrative": [
        {
          "text": "Only repository administrators can run the retry-tracker script.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
