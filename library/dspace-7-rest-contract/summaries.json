      "narrative": [
        {
          "text": "How the metadata-export script works. It reads the metadata of the given item, collection or community from the database and writes it to a CSV file. By default only the fields users normally edit (such as title, author and date) are exported; -a/--all adds the fields that are not normally changed, such as provenance.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
          },
          "drafted_at": "2026-11-01"
        }
      ]
    },
