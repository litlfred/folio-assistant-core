    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s756-collection",
      "source": "sections/s756-collection.md",
      "source_hash": "792536b453f0f03dfa5bc384d9a749575d4b4be03b09a7e31f0d2bd508897136",
      "narrative": [
        {
          "text": "/api/submission/workspaceitems/<id>/collection is read-only and returns the collection the in-progress submission belongs to. The collection cannot be changed directly once the submission exists; a section such as the enhanced select-collection section planned for DSpace 7 could change it through the sections data. The example is still to be provided.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt8n45nmwCHCTpc28EY"
          },
          "drafted_at": "2026-11-01"
        }
