        }
      ]
    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s050-bitstream-formats-endpoints",
      "source": "sections/s050-bitstream-formats-endpoints.md",
      "source_hash": "df73bc89360c6145511a39f1de779bf2240a73f34ec35cfa5ce0b702e0509971",
      "narrative": [
        {
          "text": "Heading for the bitstream formats endpoints, with a link back to the list of all endpoints.",
