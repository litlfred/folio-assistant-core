          "drafted_at": "2026-11-01"
        }
      ]
    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s047-eperson",
      "source": "sections/s047-eperson.md",
      "source_hash": "1253405c2f5f4e28207568a0e554adad6914467fa084e4fe92ac21963f795566",
      "narrative": [
        {
          "text": "Specifies the eperson link of an authorization, which returns the eperson, or 204 when the authorization is for anonymous users.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "claude-opus-5-5",
            "session": "https://claude.ai/code/session_01Qmmkt9ASjBS6Ee3g12CWge"
          },
          "drafted_at": "2026-11-01"
        }
      ]
    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s048-object",
      "source": "sections/s048-object.md",
      "source_hash": "c95ec489be1dffa8ab005162b63a8ca7c66800556d679befc380154fca007e18",
      "narrative": [
        {
          "text": "Specifies the object link of an authorization, which returns the resource the authorization is scoped to.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "claude-opus-5-5",
            "session": "https://claude.ai/code/session_01Qmmkt9ASjBS6Ee3g12CWge"
          },
          "drafted_at": "2026-11-01"
        }
      ]
    },
    {
      "block": "library/dspace-7-rest-contract/blocks/prose-s049-feature",
      "source": "sections/s049-feature.md",
      "source_hash": "d154fbe1333cb7aa1c073a13464357cc85890f17a9e6d4b76e5a74638006323e",
      "narrative": [
        {
          "text": "Specifies the feature link of an authorization, which returns the feature the user can access through it.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
