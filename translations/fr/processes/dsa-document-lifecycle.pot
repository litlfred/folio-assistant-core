msgstr ""

#: ../folio-assistant-core/processes/content/dsa-document-lifecycle.bpmn:255
#. Diagram element documentation
msgid "Publish the files at the version's immutable URL. If the parties' names are sensitive, publish only the template and the hash of the signed instance."
msgstr ""

#: ../folio-assistant-core/processes/content/dsa-document-lifecycle.bpmn:254
#. Diagram label
