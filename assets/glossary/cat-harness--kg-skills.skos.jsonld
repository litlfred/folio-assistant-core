      "skos:prefLabel": [
        {
          "@value": "deterministic-and-agentic"
        }
      ],
      "skos:definition": [
        {
          "@value": "Workflow processing is a SPECTRUM, not a switch. The four mechanisms this repository uses to sit at different points on it, the four axes an answer has to name, what is measured today, and the three research questions — which are open, and marked as open."
        }
      ],
      "skos:notation": "deterministic-and-agentic",
