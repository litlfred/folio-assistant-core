    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/evidence-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "evidence-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Evidence review as an instance of untainted verification — the separation of the appraising party from the drafting party, what recurring surveillance in a living guideline shares with a stale QA verdict, and which of guideline methodology's rules are fenced rather than shipped."
        }
      ],
      "skos:notation": "evidence-review",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/evidence-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/external-registry-contract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "external-registry-contract"
        }
      ],
      "skos:definition": [
        {
          "@value": "The contract the `external-registry` role is held to: what a trusted registry outside this layer must provide for a portal to verify what it received, and what the verifier does when it cannot. The narrowest contract the diagrams require. A mechanical role's skill is a contract to test against, not instructions to read."
        }
      ],
      "skos:notation": "external-registry-contract",
      "dcterms:source": "cat-harness/skills/kg/kg-core/external-registry-contract.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/feedback-deep-links",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "feedback-deep-links"
        }
      ],
      "skos:definition": [
        {
          "@value": "The deep-link rule for every request for feedback, review, sign-off or acceptance on something rendered: carry the staging preview, one deep link per changed page with the same page on main, pages taken from the change rather than chosen, the third state said rather than hidden, and the request placed where the person will look."
        }
      ],
      "skos:notation": "feedback-deep-links",
      "dcterms:source": "cat-harness/skills/authoring/content-lifecycle/feedback-deep-links.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/flushable-containers",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "flushable-containers"
        }
      ],
      "skos:definition": [
        {
          "@value": "A flushable container is a named store that accumulates by design — a trash you can recover from, a review preview, a console log. It declares a buffer limit, badges when over it, and offers three flush actions: flush all, trim to limit, and select to prune. What \"flush\" means, and which end of the order is expendable, are declared per container and differ."
        }
      ],
      "skos:notation": "flushable-containers",
      "dcterms:source": "cat-harness/skills/kg/kg-core/flushable-containers.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/folio-init",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "folio-init"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scaffold a new folio layer from the harness — the instantiate affordance of the knowledge graph. Covers when to run folio-init vs remote-mount, what the scaffold writes, the builder shim, state branch seeding, write capability requirements, and --dry-run degradation."
        }
      ],
      "skos:notation": "folio-init",
      "dcterms:source": "cat-harness/skills/kg/kg-core/folio-init.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/getting-started",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "getting-started"
        }
      ],
      "skos:definition": [
        {
          "@value": "Triage what a person means when they ask to create a folio, and route them. Five requests share one sentence — a folio in a new repo, folio-assistant overlaid on an existing repo, a second folio in a layer that already has one, a content object they called a folio, or something the filesystem cannot tell apart. Reads the repository facts, runs them through the folio-intent decision table, asks a selectable question for what facts cannot settle, scaffolds, and reports the published URL. Use whenever a user asks to create, start, set up, or initialise a folio, a paper, a DAK, an IG, or \"folio-assistant\" itself."
        }
      ],
      "skos:notation": "getting-started",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/getting-started.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/git-friendly-churn",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "git-friendly-churn"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write files that git keeps many versions of (caches, published sites, generated indexes) so each new version costs a small delta, not a whole copy. The rules: the same bytes when nothing changed, stable paths, per-build facts kept apart, no compressed blobs, and how to measure it."
        }
      ],
      "skos:notation": "git-friendly-churn",
      "dcterms:source": "cat-harness/skills/process/process-core/git-friendly-churn.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/graph-detanglement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "graph-detanglement"
        }
      ],
      "skos:definition": [
        {
          "@value": "Drive a tangled graph toward a clean partition, so a sub-graph can be split off when it grows too large or when a business reason separates it. The staged practice — declare in place, detangle, isolate, extract — and the seventeen moves for measurement, ordering, judgement and enforcement."
        }
      ],
      "skos:notation": "graph-detanglement",
      "dcterms:source": "cat-harness/skills/kg/graph-management/graph-detanglement.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/graph-rendering",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "graph-rendering"
        }
      ],
      "skos:definition": [
        {
          "@value": "Draw any graph in a harness (schemas, processes, a folio's block graph and any formal relation its content type adds, a detangle partition) so the picture is derived, checkable and readable. Ten rules, which engine to lay a graph out with and why, and how each graph typology here applies them."
        }
      ],
      "skos:notation": "graph-rendering",
      "dcterms:source": "cat-harness/skills/kg/graph-management/graph-rendering.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/hand-back-to-discussion",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "hand-back-to-discussion"
        }
      ],
      "skos:definition": [
        {
          "@value": "A sibling agent, spawned during or working beside a live agent-human discussion, hands every card, question, decision, result, blocker or piece of context back to the discussion agent that is talking with the person, and never leaves it only in its own thread. The discussion agent asks the person (ask-the-person), marks every copy answered, and routes the answer back. A review sheet or issue in play is an extra channel. Use whenever an agent that is not the one talking with the person has something the person must see."
        }
      ],
      "skos:notation": "hand-back-to-discussion",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/hand-back-to-discussion.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/harness-projections",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "harness-projections"
        }
      ],
      "skos:definition": [
        {
          "@value": "Who may write under `.claude/`, and when. The generated projections of the knowledge graph (`.claude/commands/*.md` from `skill:commands`, the assembled agent memory under `.claude/agents/` and `.claude/agent-memory/`) are written by CI, which commits them to the PR branch, and never by an agent. A hand-edited `.claude/` file (`settings.json`, its hooks, a hand-written command or agent definition) changes only with the owner's explicit consent to that change: the agent shows the exact diff and the reason, asks first, and records the consent. Read before staging any path under `.claude/`."
        }
      ],
      "skos:notation": "harness-projections",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/harness-projections.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/harness-requirements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "harness-requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "What a layer OWES for every directory it declares — a visualiser, a documentation entry, a governing skill, json/jsonld/schema.json serialisations at the directory's URL and at every node beneath it, and a starting README of its own. Read before declaring a directory, before adding a graph typology, and when reading `check:subgraph-coverage`. Carries which obligations are ranked as unmet promises rather than unanswered questions, why the discriminator is \"is this the static knowledge graph\", and which single obligation a harness may never waive."
        }
      ],
      "skos:notation": "harness-requirements",
      "dcterms:source": "cat-harness/skills/kg/kg-core/harness-requirements.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/harness-tiles",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "harness-tiles"
        }
      ],
      "skos:definition": [
        {
          "@value": "A tile is a function of the harness watching a directory, not of nodes. Where the tile set comes from, what a tile opens, and the two gaps it reports rather than hides."
        }
      ],
      "skos:notation": "harness-tiles",
      "dcterms:source": "cat-harness/skills/ui/ui-core/harness-tiles.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/index-config",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "index-config"
        }
      ],
      "skos:definition": [
        {
          "@value": "`index.config.json` at an instantiation root says which harnesses the checkout instantiates, where each one comes from (local, or a remote mount pinned to a SHA), each layer's config INLINE in its entry (a legacy `<name>.config.json` is only imported until `--inline` retires it), and which harness `/` is. Covers instantiated against declared, landing resolution and its error case, `index.lock.json` and its legacy fallback, the reserved `index` stem, the generated `.gitignore` block and its gate, and `index-config:migrate` (with `--inline`) for separated repositories."
        }
      ],
      "skos:notation": "index-config",
      "dcterms:source": "cat-harness/skills/kg/kg-core/index-config.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/injection-boundaries",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "injection-boundaries"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where a value becomes program rather than data — workflow expressions, shell strings, and archive members. What the gate covers, why a step output carries a severity rather than having one, and the argv rule."
        }
      ],
      "skos:notation": "injection-boundaries",
      "dcterms:source": "cat-harness/skills/conduct/security/injection-boundaries.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/instance-kinds",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "instance-kinds"
        }
      ],
      "skos:definition": [
        {
          "@value": "How to make a new KIND of harness layer — choosing the prefix family, the keep-the-kind's-name default and the owner's right to decline it, which inherited files the new owner may repoint, and what a new GRAPH typology must declare. Read before naming a new layer, before adding a value to the graph-typology registry, and before building a visualiser. Carries the test that usually says \"this is not a new kind\"."
        }
      ],
      "skos:notation": "instance-kinds",
      "dcterms:source": "cat-harness/skills/kg/kg-core/instance-kinds.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/instance-publication",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "instance-publication"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every asset carries an id and a version and sits in DRAFT. Publication is a state, not a boolean, and `published` is refused by the schema because the formal process does not exist yet. Carries the id namespace rule, why a mirror never takes its subject's identity, and what a consumer may assume of a draft. Also the one home for which graph each layer publishes, where, under which IRI and schema, and what is stripped from it."
        }
      ],
      "skos:notation": "instance-publication",
      "dcterms:source": "cat-harness/skills/kg/kg-core/instance-publication.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/interaction-modality",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "interaction-modality"
        }
      ],
      "skos:definition": [
        {
          "@value": "Establish how to talk to the person in front of you before deciding what to say — audio, ordinary chat, selectable options for limited hand function, large-type for low vision, plain language — and hold that choice durably so every later session and sibling agent honours it. Covers the accessibility rules a conversational agent can actually keep, the settings surface in the published site, and how to drive a question set from DMN so the SAME logic serves every modality. Use at first contact with a new user, when a user reports difficulty answering, whenever a question is about to be asked, and before any long free-text prompt."
        }
      ],
      "skos:notation": "interaction-modality",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/interaction-modality.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/journey-maps",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "journey-maps"
        }
      ],
      "skos:definition": [
        {
          "@value": "Journeys and workshops as knowledge-graph content: a DAK user scenario told as a journey map (`user-scenario` kind: ordered steps, per person what they do and feel, pain points, enablers, the record's trust state, and edges to stories, BPMN tasks, requirements, FHIR examples, building blocks and the DAK's data sets, decision tables and indicators), the `building-blocks` catalogue its steps use, a workshop that teaches from it (`workshop` kind: modules, objectives, questions for the room on each step, reference tables, sheets, job aids), the `journeys-viewer` visualiser that draws them for a layer and the layers it mounts, and the `check:journey-refs` gate that every reference they name resolves. Read before writing a journey or a workshop, before declaring the viewer, and before building a journey walkthrough app of your own."
        }
      ],
      "skos:notation": "journey-maps",
      "dcterms:source": "cat-harness/skills/ui/ui-core/journey-maps.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-affordances",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-affordances"
        }
      ],
      "skos:definition": [
        {
          "@value": "The four affordances of a conformant knowledge graph — browse, materialise, instantiate and copy-into-folio — which capabilities each requires, how each writing verb degrades cleanly when no write capability is available, and how copying an asset stamps KgAsset.source provenance."
        }
      ],
      "skos:notation": "kg-affordances",
      "dcterms:source": "cat-harness/skills/kg/kg-core/kg-affordances.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-contribution-offer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-contribution-offer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask whether agreed requirements should become knowledge-graph content, and as what — in a form the person can answer by selecting. Use at the end of CRDM sign-off, or whenever a body of agreed work could become a skill, a process, a schema or a work item and nobody has been asked. Offers \"none\" as a first-class answer."
        }
      ],
      "skos:notation": "kg-contribution-offer",
      "dcterms:source": "cat-harness/skills/kg/kg-core/kg-contribution-offer.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-export",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-export"
        }
      ],
      "skos:definition": [
        {
          "@value": "Serialize a layer's knowledge graph to one JSON document, for publication and inspection. Read when asked to visualize, audit or share the KG, before adding a node type to the export, and before minting or authoring any subject IRI — subjects are `<doc dir>/<kind>/<id>`, never `#fragments`."
        }
      ],
      "skos:notation": "kg-export",
      "dcterms:source": "cat-harness/skills/kg/kg-core/kg-export.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-navigation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-navigation"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a cold agent finds and loads the skill that governs its task. The two Tools that serve the knowledge graph — the MCP pair and the filesystem fallback — what counts as a skill, and the three ways the search goes wrong."
        }
      ],
      "skos:notation": "kg-navigation",
      "dcterms:source": "cat-harness/skills/kg/kg-navigation/kg-navigation.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-separation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-separation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Separate a Knowledge Graph into its own repository — as a CONTENT repository (files to read, no code) and a TOOLS repository (the code that writes and checks it) — once it is too large, or its consumers or cadence differ. The end-to-end method: the signals that trigger it, the preconditions, eleven stages each with the command that gates it, the owner's decision points, how identifiers, QA and publication move, how the parent consumes the result, rollback, and the post-move sweep that a move between the pair owes before the parent re-pins. graph-detanglement owns stages 1–3; this skill owns the rest. Bootstrap + bootstrap-tools and cat-harness + the tools layer are the worked examples."
        }
      ],
      "skos:notation": "kg-separation",
      "dcterms:source": "cat-harness/skills/kg/graph-management/kg-separation.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-subgraph-layout",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-subgraph-layout"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lay out one declared sub-graph of a knowledge graph (a harness's schema overview, one named sub-graph, a declaration's kinds) as a single Graphviz diagram in the i2ce Form Documentor's convention, and show it on the site laid out in the reader's browser by Graphviz in WebAssembly, with pan, zoom, find, keyboard control and draggable nodes. The DOT is a third rendering of the model the PlantUML and Mermaid already draw, coloured from the same stylesheet. Tool `uml-overview`."
        }
      ],
      "skos:notation": "kg-subgraph-layout",
      "dcterms:source": "cat-harness/skills/kg/graph-management/kg-subgraph-layout.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-subscription",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-subscription"
        }
      ],
      "skos:definition": [
        {
          "@value": "Subscribing a folio or harness to an external knowledge graph — a substrate — and walking its parts from referenced to materialised, one at a time and only through the shared materialisation gates. When to subscribe, what makes a repository a substrate, choosing subgraphs, assets and harnesses, the five gates, instantiating a harness so it reaches the navbar, moving the pin, and what never to do."
        }
      ],
      "skos:notation": "kg-subscription",
      "dcterms:source": "cat-harness/library/skills/large-datasets/kg-subscription.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-to-portal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-to-portal"
        }
      ],
      "skos:definition": [
        {
          "@value": "Getting a knowledge graph out to a public portal — the six stages between \"the graph is in the repository\" and \"a reader's browser has the bytes\", why a CDN is a layer rather than a publication host, and which decisions are the deployment's to make rather than the pipeline's."
        }
      ],
      "skos:notation": "kg-to-portal",
      "dcterms:source": "cat-harness/skills/kg/kg-core/kg-to-portal.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/kg-viewer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-viewer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render a published knowledge-graph document so a person can read it — faceted index, node detail, followable edges, and an honest account of what the document is missing. Host-agnostic; the publishing is a separate Tool."
        }
      ],
      "skos:notation": "kg-viewer",
      "dcterms:source": "cat-harness/skills/ui/ui-core/kg-viewer.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/library-ingestion",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "library-ingestion"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BASIC ingestion flow every asset takes: an upload is accepted, its metadata goes into the knowledge graph, and the asset lands in `library/<slug>/` if it is materialized. The two entry points (a drop in `uploads/`, or materializing an asset a remote graph lists), what happens to the upload afterwards, and why content-type methods refine this flow from above rather than living in it. Command: `bun run cat ingest`."
        }
      ],
      "skos:notation": "library-ingestion",
      "dcterms:source": "cat-harness/library/skills/library-core/library-ingestion.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/liquid-templates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "liquid-templates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Authoring a Liquid template in this repository — a README template the `subgraph-readmes` Tool renders with liquidjs, or a Jekyll include on the just-the-docs site. Where templates live (inside a declared directory, reached through its id), what a template may read (only what the Knowledge Graph hands it), the leading comment the generator reads as the file's description, includes, whitespace control, escaping, and regenerate-then-commit with the `--check` gate. Read it before adding or changing any `.liquid` file or anything under `docs/_includes/`."
        }
      ],
      "skos:notation": "liquid-templates",
      "dcterms:source": "cat-harness/skills/ui/ui-core/liquid-templates.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/literature-search",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "literature-search"
        }
      ],
      "skos:definition": [
        {
          "@value": "Finding the source a node cites but does not hold — memory first, then this repository, then open-access services. Always produce a DIRECT download link. Read before recording that a citation cannot be found, and before appraising any source you have not opened. Its central rule: a blocked network is not a missing document, and the two must never share a report."
        }
      ],
      "skos:notation": "literature-search",
      "dcterms:source": "cat-harness/library/skills/library-core/literature-search.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/lsi-indexing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "lsi-indexing"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build, read and audit a Latent Semantic Indexing index over a declared prose graph — a library, the skills, the work items, docs — to find units that discuss the same thing in different words, near-duplicates, outlier clusters, and a proposed home for unfiled work. Every output is a proposal; LSI never writes a relation."
        }
      ],
      "skos:notation": "lsi-indexing",
      "dcterms:source": "cat-harness/skills/kg/graph-management/lsi-indexing.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/markdown-render-check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "markdown-render-check"
        }
      ],
      "skos:notation": "markdown-render-check",
      "dcterms:source": "cat-harness/skills/ui/ui-core/markdown-render-check.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/materialize-on-demand",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "materialize-on-demand"
        }
      ],
      "skos:definition": [
        {
          "@value": "After bootstrap, a person asks for part of a remote subgraph to be held locally. Check what is already here (cache:index), put a number on the ask before anything is fetched, then run materialize-remote. Eviction is a report, never an act."
        }
      ],
      "skos:notation": "materialize-on-demand",
      "dcterms:source": "cat-harness/library/skills/large-datasets/materialize-on-demand.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/materialize-remote",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "materialize-remote"
        }
      ],
      "skos:definition": [
        {
          "@value": "Landing remote content locally — the five gates, the three states, and the two purposes. One process, shared by catalogue import and harness bootstrap, plus the refresh that is not a re-import."
        }
      ],
      "skos:notation": "materialize-remote",
      "dcterms:source": "cat-harness/library/skills/large-datasets/materialize-remote.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/mcp-assembly",
