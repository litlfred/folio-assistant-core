      },
      "skos:prefLabel": [
        {
          "@value": "decision-comparison"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lay a decision out as a comparison before you ask it — what each option does, its pro, its con, what it changes downstream, and how reversible it is — in the prose that precedes the question, never inside the option labels. Required whenever a choice is handed to a person."
        }
      ],
      "skos:notation": "decision-comparison",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/decision-comparison.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/decision-methodology-selector",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "decision-methodology-selector"
        }
      ],
      "skos:definition": [
        {
          "@value": "Given a decision context, select the applicable methodology from the methodology graph. Reads the graph's applies-when declarations, matches them against the context, and returns the ranked applicable methods with rationale. Extends methodology-adoption's four-question protocol with quantitative method-selection criteria from the MCDM literature."
        }
      ],
      "skos:notation": "decision-methodology-selector",
      "dcterms:source": "cat-harness/skills/process/process-core/decision-methodology-selector.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/deletion-requires-confirmation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "deletion-requires-confirmation"
        }
      ],
      "skos:definition": [
        {
          "@value": "An agent never removes a durable artefact on its own initiative. Report what would go, with sizes and ages, and wait for the user to say so. Covers what counts as durable, the non-destructive move for each kind, and the rule that a workflow whose shape deletes something counts as a deletion nobody decided."
        }
      ],
      "skos:notation": "deletion-requires-confirmation",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/deletion-requires-confirmation.md",
