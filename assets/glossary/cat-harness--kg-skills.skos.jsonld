      "skos:prefLabel": [
        {
          "@value": "canonical-watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Derivation-discipline integration watcher — watches the default branch + open active PRs + newly-opened PRs for non-canonical empirical / fitting / calibration inputs beyond the project's declared set, numerology, or justification/rationalization in place of derivation. Inherits shared mechanics (Monitor, subscriptions, queue, ledger, idle sweep, author-ask, watch-prepared-PRs, witness-drift recovery, billing-quick-fail flake, post-completion one-voice, sibling-PR comment protocol, backlog-found PR spin-up, handover docs) from `sdlc-core/integration-watcher`."
        }
      ],
      "skos:notation": "canonical-watcher",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/canonical-watcher.md",
