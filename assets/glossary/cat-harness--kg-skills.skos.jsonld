      },
      "skos:prefLabel": [
        {
          "@value": "mcp-assembly"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compose several Tool nodes into one MCP service — naming, collisions, grouping and versioning. Read when a service will expose more than one tool, or when two layers' tools land in the same namespace."
        }
      ],
      "skos:notation": "mcp-assembly",
      "dcterms:source": "cat-harness/skills/tools/folio-core/mcp-assembly.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/mcp-contract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "mcp-contract"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify an MCP service's tools against the Tool nodes and skill declarations they came from — I/O equivalence in both directions. Read before shipping a projected server, and when a tool call fails with an argument the schema said was fine."
        }
      ],
      "skos:notation": "mcp-contract",
      "dcterms:source": "cat-harness/skills/tools/folio-core/mcp-contract.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/mcp-projection",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "mcp-projection"
        }
      ],
      "skos:definition": [
        {
          "@value": "Generate an MCP server from Tool nodes — the mapping from this harness's skill/Tool vocabulary onto the current MCP standard. Read before exposing a CLI tool over MCP, or when asked how an agent stands a service up."
        }
      ],
      "skos:notation": "mcp-projection",
      "dcterms:source": "cat-harness/skills/tools/folio-core/mcp-projection.md",
      "skos:note": "candidate"
    },
