      ],
      "skos:definition": [
        {
          "@value": "Which audits reach which KIND of node, measured rather than inferred. Read before concluding that a corpus is unaudited, before writing a criterion for one, and before building any coverage report — the gate half must be declared, an undeclared declarer is counted, and the stored record holds the relation rather than the census."
        }
      ],
      "skos:notation": "audit-coverage",
      "dcterms:source": "cat-harness/skills/kg/kg-core/audit-coverage.md",
