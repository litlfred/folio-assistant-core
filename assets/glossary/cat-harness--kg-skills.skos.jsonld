    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/methodology-adoption",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "methodology-adoption"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a named external methodology enters the knowledge graph, and how an agent picks which one applies. Read before following a judgement method, before adopting a new one, and before writing a house method instead of adopting one."
        }
      ],
      "skos:notation": "methodology-adoption",
      "dcterms:source": "cat-harness/skills/process/process-core/methodology-adoption.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/npm-kg-distribution",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "npm-kg-distribution"
        }
      ],
      "skos:definition": [
        {
          "@value": "Package, release, distribute, and retrieve Knowledge Graphs using npm tooling and tarballs: declare `package.json` as an authored pre-packaging asset in the Knowledge Graph, build `.tgz` packages via `bun pm pack`, record publications as `folio-binary-release/v1` state documents hosted on GitHub binary releases, and retrieve remote Knowledge Graphs using `npm install` for both unhydrated source graph and hydrated materialized graph views."
        }
      ],
      "skos:notation": "npm-kg-distribution",
      "dcterms:source": "cat-harness/skills/kg/kg-core/npm-kg-distribution.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/one-voice-style-guide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "one-voice-style-guide"
        }
      ],
      "skos:definition": [
        {
          "@value": "Author voice profile and narrative style guide. Reference when authoring or editing prose. Pairs with `one-voice-audit` (mechanical sweep for status leaks, emoji, and Unicode crashes)."
        }
      ],
      "skos:notation": "one-voice-style-guide",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/one-voice-style-guide.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/path-containment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "path-containment"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turning a value from outside into a path. The two different questions — a URL path versus a single identifier — why collapsing them is a defect, and how to find every sink that needs a check."
        }
      ],
      "skos:notation": "path-containment",
      "dcterms:source": "cat-harness/skills/conduct/security/path-containment.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/placement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "placement"
        }
      ],
      "skos:definition": [
        {
          "@value": "Establish where a new node belongs BEFORE you create it — which layer, which declared graph, which kind of node, and which of the two \"stub\" conventions applies. Read before adding a skill, role, actor, workflow, decision table, schema, tool or content object, and before writing any literal that names one folio."
        }
      ],
      "skos:notation": "placement",
      "dcterms:source": "cat-harness/skills/kg/kg-core/placement.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/process-state",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "process-state"
        }
      ],
      "skos:definition": [
        {
          "@value": "Track where you are inside a running process — which task, in which swimlane, under which role — and recover deliberately when you find yourself outside it. Read before completing a workflow step, and whenever something unexpected interrupts one. Covers what to do about notes and stickies you re-anchored while off-process, which leave no trace in the artefact."
        }
      ],
      "skos:notation": "process-state",
      "dcterms:source": "cat-harness/skills/process/workflow/process-state.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/raci",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "raci"
        }
      ],
      "skos:definition": [
        {
          "@value": "RACI over this repository's processes — who is Responsible, Accountable, Consulted and Informed for each activity. Three declared edge kinds over the roles and BPMN activities that already exist, not a new party registry. Use it to work out involvement when a project is initiated, and to sketch its breakdown."
        }
      ],
      "skos:notation": "raci",
      "dcterms:source": "cat-harness/skills/process/raci/raci.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/readme-sections",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "readme-sections"
        }
      ],
      "skos:definition": [
        {
          "@value": "A folio's README is the author's file; the platform owns only the marked regions it generates. How the sync/audit split works, why the platform never generates a folio's prose, and the third state both tools must report."
        }
      ],
      "skos:notation": "readme-sections",
      "dcterms:source": "cat-harness/skills/ui/ui-core/readme-sections.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/remote-mount",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "remote-mount"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bring a harness, and every layer it depends on, into a checkout that does not hold it, from another repository at a pinned commit, as declared directories with a lock: a `source.remote` entry in the downstream's root `index.config.json` (legacy: `remoteMounts` on its declaration) and `mountDefaults` on the harness. Covers when to mount and when to subscribe instead, why there are no submodules and no `.deps/`, the transitive closure through `needs` and gitlinks, overrides by id, the lock, and the three states."
        }
      ],
      "skos:notation": "remote-mount",
      "dcterms:source": "cat-harness/skills/kg/kg-core/remote-mount.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/render-kg-to-cdn",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "render-kg-to-cdn"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render a Knowledge Graph, or a list of its Subgraphs, for publication to a CDN at a publication root URL, and report a status and one message. The same step for a staging preview and for a release — only the root URL and the target differ. Names the target's Tool, never its steps: GitHub Pages (`gh-pages`) is one Tool, and it carries its own subprocess."
        }
      ],
      "skos:notation": "render-kg-to-cdn",
      "dcterms:source": "cat-harness/skills/process/workflow/render-kg-to-cdn.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/render-logging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "render-logging"
        }
      ],
      "skos:definition": [
        {
          "@value": "Log every render to the publish branch — what was published, removed, restored or deliberately retained — to an append-only log that lives beside what it describes. Use when adding or removing anything on `gh-pages`, when asking \"what happened to this preview\", or before writing a workflow step that deletes a published artefact."
        }
      ],
      "skos:notation": "render-logging",
      "dcterms:source": "cat-harness/skills/ui/ui-core/render-logging.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/render-order",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "render-order"
        }
      ],
      "skos:notation": "render-order",
      "dcterms:source": "cat-harness/skills/ui/ui-core/render-order.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/repo-conversion",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "repo-conversion"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lay folio-assistant over a repository that already exists, without losing or silently moving what is in it. Scans the tree read-only, classifies candidate files into library (external source) and content (authored here) with an explicit third bucket for what it cannot classify, scans outside the content tree for mathematical evidence and refutations, lists the content markers (an IG, a DAK, processes, work items, library, Lean, folio manifests) the harness could declare and declares only the ones the person picks, puts the three questions the scan cannot answer to the author as selections, and hands ingestion to one agent or a small swarm. Use when a user wants an existing repo converted to a folio, asks to import what is already there, asks whether their PDFs/notes/drafts can come along, or asks what else in a repository an existing harness could declare."
        }
      ],
      "skos:notation": "repo-conversion",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/repo-conversion.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/retry-backoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "retry-backoff"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every error gets a falling-off retry rate — each wait doubles, with jitter. Read before writing any call that can fail transiently, and before deciding that a failure is worth retrying at all. Exhausting the retries does not change the verdict."
        }
      ],
      "skos:notation": "retry-backoff",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/retry-backoff.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/review-heatmap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-heatmap"
        }
      ],
      "skos:definition": [
        {
          "@value": "The review page's heat map: a section-by-metric table that tells a reviewer of a large document where to look first. Says what each column MEANS and what it must NOT be read as, where each number comes from, what a column says when a build lacks its data, and how the colour was chosen. Use when a reviewer or author asks \"where do I start\", reads a number off the heat map, or asks why coverage or QA say \"no data\"; and before adding a column."
        }
      ],
      "skos:notation": "review-heatmap",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/review-heatmap.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/role-model",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "role-model"
        }
      ],
      "skos:definition": [
        {
          "@value": "Actors, roles and skills — who performs a BPMN task, under which swimlane, with which skills. How a role's skill set is resolved through `inherits` and through a subprocess call chain, how a lane binds to a declared role, and how `kg:audit` finds a dangling skill, lane, role or decision."
        }
      ],
      "skos:notation": "role-model",
      "dcterms:source": "cat-harness/skills/process/process-core/role-model.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/sample-import",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "sample-import"
        }
      ],
      "skos:definition": [
        {
          "@value": "Testing an import of a SAMPLE of a remote source into a knowledge graph or other structured store: scope it, let materialize-remote gate it, land it in the library (permanent) or the kept, unpublished trashcan (trial), import it, and test the import. The gates are called, never copied."
        }
      ],
      "skos:notation": "sample-import",
      "dcterms:source": "cat-harness/library/skills/large-datasets/sample-import.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/schema-management",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "schema-management"
        }
      ],
      "skos:definition": [
        {
          "@value": "Manage a schema over its life — add one, change one, read the schema graph and its viewer, and act on what the reader could not determine. The layout rule lives in `directory-conventions`; the entity question lives in `data-modelling`; this is the work in between."
        }
      ],
      "skos:notation": "schema-management",
      "dcterms:source": "cat-harness/skills/kg/kg-core/schema-management.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/scientific-accuracy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "scientific-accuracy"
        }
      ],
      "skos:notation": "scientific-accuracy",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/scientific-accuracy.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/security",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "security"
        }
      ],
      "skos:definition": [
        {
          "@value": "The security sub-KG's entry point. What the boundaries are, which machinery already guards each one, and the single rule that unifies them — refuse, never repair. Read this before adding a check, so the answer that already exists is reused rather than rebuilt in a fourth place."
        }
      ],
      "skos:notation": "security",
      "dcterms:source": "cat-harness/skills/conduct/security/security.md",
      "skos:note": "candidate"
    },
