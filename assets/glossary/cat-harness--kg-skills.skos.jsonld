      },
      "skos:prefLabel": [
        {
          "@value": "docs-generation"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a checkout of this harness generates and publishes its docs site: regenerating derived references, composing the docs layers and each layer's site into one Jekyll source, building it with just-the-docs, the post-build passes, the TypeDoc API reference, the knowledge-graph export, and the full-replace publish to gh-pages and its branches/ previews."
        }
      ],
      "skos:notation": "docs-generation",
      "dcterms:source": "cat-harness/skills/ui/ui-core/docs-generation.md",
