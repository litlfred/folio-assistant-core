      ],
      "skos:definition": [
        {
          "@value": "The general pattern for caching expensive compiled artefacts (Lean .oleans, FHIR ASTs) across builds. Defines branch-based storage, validity checking, exit code protocol, safety guards, and the restore→build→contribute loop."
        }
      ],
      "skos:notation": "compiled-artefact-cache",
      "dcterms:source": "cat-harness/skills/process/process-core/compiled-artefact-cache.md",
