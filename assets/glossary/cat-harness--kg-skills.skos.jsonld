      "skos:definition": [
        {
          "@value": "Declare a harness this one knows about and does not hold (`associatedHarnesses`): a folio in another repository, published at its own site. Referenced, never loaded, never materialized."
        }
      ],
      "skos:notation": "associate-harness",
