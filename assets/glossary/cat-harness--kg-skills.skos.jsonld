      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/site-presentation-assets",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "site-presentation-assets"
        }
      ],
      "skos:definition": [
        {
          "@value": "A visual fact — a colour, a glyph, a theme — lives in a graph node, and the stylesheet the site serves is a rendering of it. Read before adding a colour, an icon or a theme, before hand-editing any generated stylesheet, and before referencing a generated asset from a page."
        }
      ],
      "skos:notation": "site-presentation-assets",
      "dcterms:source": "cat-harness/skills/ui/theming/site-presentation-assets.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/skill-registration",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "skill-registration"
        }
      ],
      "skos:definition": [
        {
          "@value": "Adding a skill is never a one-file change. What a new skill file owes, the one command that performs the derived half, the one declaration it deliberately leaves to you, why running it once is not enough, and the two orphan directions it reports rather than fixes. Read this before adding, renaming or removing a skill."
        }
      ],
      "skos:notation": "skill-registration",
      "dcterms:source": "cat-harness/skills/kg/kg-core/skill-registration.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/skill-voice-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "skill-voice-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reviews a skill against a voice that judges skills — the base `agent-skill-authoring` voice or a vendor override such as Claude's, Gemini CLI's or OpenAI's — rule by rule, with each rule's citation open, and records the verdicts with `voice:review`. Use when `skill-voice-review-current` reports a skill never reviewed or reviewed before the skill or the voice changed, or when asked whether a skill follows a vendor's authoring guidance. The agent half of that axis; the mechanical half, in `scripts/skill-voice-review.ts`, only says whether a current review exists."
        }
      ],
      "skos:notation": "skill-voice-review",
      "dcterms:source": "cat-harness/skills/kg/kg-core/skill-voice-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/skills-and-tools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "skills-and-tools"
        }
      ],
      "skos:definition": [
        {
          "@value": "A skill states a capability generically; a Tool node carries the concrete mechanism. Read before writing or editing any skill, and whenever a skill is about to name a vendor, a CLI, a binary or an API endpoint."
        }
      ],
      "skos:notation": "skills-and-tools",
      "dcterms:source": "cat-harness/skills/tools/folio-core/skills-and-tools.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/specification-compiled-agents",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "specification-compiled-agents"
        }
      ],
      "skos:definition": [
        {
          "@value": "When a diagram already says what the process is, the model should not be planning it. The two gaps between this repository's engine and a compiled control plane — typed node contracts and per-node context scope — what to do before either exists, and the three things not to adopt with the method."
        }
      ],
      "skos:notation": "specification-compiled-agents",
      "dcterms:source": "cat-harness/skills/process/workflow/specification-compiled-agents.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/sub-kg-lifecycle",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "sub-kg-lifecycle"
        }
      ],
      "skos:definition": [
        {
          "@value": "A sub-KG is a knowledge graph staged as a directory inside a harnessed repository, declared as its own layer, that may later leave for a repository of its own. The lifecycle: declare it in place, grow it, stage it for separation (one import seam, the separation guard, a self-contained rehearsal), and then, each behind an explicit owner confirmation, create the repository, copy the staged contents in with history, re-point the declaration, verify on a fresh clone and delete the in-repo copy. The light sibling of kg-separation: use this for a DATA layer that leaves whole, and kg-separation when a graph must split into a content repository and a tools repository."
        }
      ],
      "skos:notation": "sub-kg-lifecycle",
      "dcterms:source": "cat-harness/skills/kg/graph-management/sub-kg-lifecycle.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/surprise-to-corpus",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "surprise-to-corpus"
        }
      ],
      "skos:definition": [
        {
          "@value": "What was unexpected in that task, and does it belong in the corpus? Logical surprise is the detectable kind, recurrence is the filter that stops this generating noise every turn, and the agent PROMPTS — it never writes corpus guidance unasked."
        }
      ],
      "skos:notation": "surprise-to-corpus",
      "dcterms:source": "cat-harness/skills/kg/kg-core/surprise-to-corpus.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/swimlane-glossary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "swimlane-glossary"
        }
      ],
      "skos:notation": "swimlane-glossary",
      "dcterms:source": "cat-harness/skills/process/process-core/swimlane-glossary.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/swot-analysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "swot-analysis"
        }
      ],
      "skos:definition": [
        {
          "@value": "Running a SWOT situation analysis — the activities of `swot-analysis.bpmn`, what each step must produce, and the one thing the technique must never be used for. The method itself lives in the `methodology` graph and is not repeated here."
        }
      ],
      "skos:notation": "swot-analysis",
      "dcterms:source": "cat-harness/skills/process/process-core/swot-analysis.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/symbiotic-interaction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "symbiotic-interaction"
        }
      ],
      "skos:definition": [
        {
          "@value": "Recognize and respond to the three epistemic registers of author input — Socratic steer (known-answer correction), honest gap (flagged unknown), and intuition seed (tenuous cross-domain identification) — with the coactive-learning measurement spec (per-arc correction quality and turns-to-convergence) and the prompt-lexicon convention. Carries the STRICT rule that a steer correcting a RULE is written into the skill that governs it, in the same turn, quoted and dated — use whenever the author corrects, settles or overrules anything. Generic platform skill."
        }
      ],
      "skos:notation": "symbiotic-interaction",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/symbiotic-interaction.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/task-authorization",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "task-authorization"
        }
      ],
      "skos:definition": [
        {
          "@value": "The check every BPMN task execution runs before anything is recorded: is the actor authenticated, assigned to the role the lane binds, authorized by an ODRL policy to perform the task, and allowed access to the content it acts on? One generic check in the engine rather than a step drawn in some diagrams; strict, with GitHub as the authenticator. Also how the HTTP routes ask the same policies. Triggers on: may this actor, who may perform, authorization, authentication, access rights, permission check, RBAC, rbac.ts, workflow_complete refused, not eligible for role."
        }
      ],
      "skos:notation": "task-authorization",
      "dcterms:source": "cat-harness/skills/process/process-core/task-authorization.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/technical-documentation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "technical-documentation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write and review technical documentation of standards, software and knowledge assets as an SDO writes. Carries the RFC 2119 requirement levels as RFC 8174 constrains them, the three questions a first draft is measured against, and the rule that an ingested specification is checked for supersession before it is cited."
        }
      ],
      "skos:notation": "technical-documentation",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/technical-documentation.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/term-disagreement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "term-disagreement"
        }
      ],
      "skos:definition": [
        {
          "@value": "When a glossary term the extractor minted and an authorised terminology disagree — the corpus spells a concept differently from the authority, or uses a word the authority does not carry — decide among three outcomes: change the prose, author a local term with its reason, or record that the vocabulary is wrong for this domain. Says which disagreements need a decision at all, how to choose, what each outcome writes and where, and what is NOT this skill (two judges disagreeing about a mapping)."
        }
      ],
      "skos:notation": "term-disagreement",
      "dcterms:source": "cat-harness/library/skills/library-core/term-disagreement.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/theme-art-intake",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-art-intake"
        }
      ],
      "skos:definition": [
        {
          "@value": "Accept or refuse a set of three theme/avatar layouts arriving through document ingestion, with a named reason for every refusal."
        }
      ],
      "skos:notation": "theme-art-intake",
      "dcterms:source": "cat-harness/skills/ui/theming/theme-art-intake.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/theme-ui-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-ui-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review graphical assets AS THEY ARE INGESTED, in the context of the website or app design they are for — accessibility, branding, languages — to determine what the assets and the UI will be. At ingestion only; called from ingest-theme. Measures rather than asserts, and raises findings rather than fixing them."
        }
      ],
      "skos:notation": "theme-ui-review",
      "dcterms:source": "cat-harness/skills/ui/ui-core/theme-ui-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/theming",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theming"
        }
      ],
      "skos:definition": [
        {
          "@value": "The map of this subgraph: theming is split on PIPELINE STAGE first — intake, declaration, generation, contrast — with producer/consumer as the direction each stage faces, and per-artefact specialisation last. Read this to find which stage owns the fact you need; read the stage for the fact."
        }
      ],
      "skos:notation": "theming",
      "dcterms:source": "cat-harness/skills/ui/theming/theming.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/todo-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "todo-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Monitor and triage open feedback across all content blocks. At session start, ask the author if they'd like to work on feedback. Provide overview, let them pick a chapter/section, then review and iterate until done."
        }
      ],
      "skos:notation": "todo-review",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/todo-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/tool-authoring",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "tool-authoring"
        }
      ],
      "skos:definition": [
        {
          "@value": "How concrete Tools are authored, structured, packaged, and registered across the separated multi-repository platform: defining Knowledge Graph Tool nodes, implementing TypeScript handlers in the tools repository, registering MCP tools, isolating toolchain dependencies, and validating tool-to-skill alignment."
        }
      ],
      "skos:notation": "tool-authoring",
      "dcterms:source": "cat-harness/skills/tools/folio-core/tool-authoring.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/translation-manager",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "translation-manager"
        }
      ],
      "skos:definition": [
        {
          "@value": "Translation lifecycle management for folio content. Covers gettext PO/POT extraction and injection, TranslationNode manifests as KG nodes, official vs unofficial translations, staleness tracking, sign-off workflow, automatic badge rendering, the poSources fallback resolution chain, and translating into several locales as a team: one extraction, a PR per locale to main, FHIR terms as CodeSystem supplements, the untainted round trip as run, and the per-locale QA report."
        }
      ],
      "skos:notation": "translation-manager",
      "dcterms:source": "cat-harness/library/skills/library-core/translation-manager.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/translation-refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "translation-refresh"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translation watcher: a scheduled fresh session that keeps every locale of every layer current after the source moves. Cold start, then, per layer, detect, refresh the templates, merge them into each locale, translate only the new and fuzzy strings with the fixed terms, run the gates, round-trip the changed strings, write the QA report, open one PR to main, merge it only where the layer declares merge-when-green, and report source mistakes as one issue. Use for \"refresh the translations\", \"a template check failed\", and when scheduling or running the watcher."
        }
      ],
      "skos:notation": "translation-refresh",
      "dcterms:source": "cat-harness/library/skills/library-core/translation-refresh.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/ui-accessibility",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "ui-accessibility"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every user interface this project produces must be operable by keyboard, legible at measured contrast, and comfortable to hit. How to build to that, how to check it, why an automated pass is not the standard, and what a rendering built client-side owes a reader — there is no no-JavaScript floor here, and the two gates that look like one are narrower than their names."
        }
      ],
      "skos:notation": "ui-accessibility",
      "dcterms:source": "cat-harness/skills/ui/ui-core/ui-accessibility.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/uml-overview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uml-overview"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read, regenerate or extend the UML class diagrams of a harness: one per harness and one per named sub-graph it declares, plus the harness object model. Every box is generated from a declaration and a schema, never drawn by hand, so a wrong diagram is fixed at the declaration or the schema, and a dashed \"could not determine\" box is a finding about the registry."
        }
      ],
      "skos:notation": "uml-overview",
      "dcterms:source": "cat-harness/skills/kg/kg-core/uml-overview.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/untrusted-input",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "untrusted-input"
        }
      ],
      "skos:definition": [
        {
          "@value": "Keep attacker-controlled values out of program text — in GitHub Actions, in command lines, in anything that is parsed before it runs. Read before interpolating any value into a script, and before giving a Tool a command-line input."
        }
      ],
      "skos:notation": "untrusted-input",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/untrusted-input.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/unverified-constraints",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "unverified-constraints"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never encode a constraint you have not verified — a rule that refuses a working setup is worse than no rule. Read before adding a check to a schema, a validator, a gate or an incompatibility table, and whenever you are about to write down that something \"is not supported\"."
        }
      ],
      "skos:notation": "unverified-constraints",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/unverified-constraints.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/upload-naming",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "upload-naming"
        }
      ],
      "skos:definition": [
        {
          "@value": "What an ingested file may be CALLED. Read before adding anything to an `uploads` or `library` graph, before writing a generator that links to one, and before \"fixing\" a broken link in a generated README. Covers which characters break what, why the name is normalised as well as the link escaped, how a sidecar stays paired with its source, and the one case the fixer refuses."
        }
      ],
      "skos:notation": "upload-naming",
      "dcterms:source": "cat-harness/library/skills/library-core/upload-naming.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/upload-routes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "upload-routes"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a file actually REACHES `uploads/` — the two mechanisms that write bytes into a declared queue, the persona that performs one of them on somebody's behalf, and what each writer owes that the route does not do for them. The step before intake and after acquisition."
        }
      ],
      "skos:notation": "upload-routes",
      "dcterms:source": "cat-harness/library/skills/library-core/upload-routes.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/uploads-watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uploads-watch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Notice what has landed in the acquisition queue, and tell an arrival from a backlog. Reports; it never deletes, and never ingests on its own say-so."
        }
      ],
      "skos:notation": "uploads-watch",
      "dcterms:source": "cat-harness/library/skills/library-core/uploads-watch.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/uses-editorial-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uses-editorial-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Adjudicate `uses-editorial-completeness` — read a block as a reader would and judge whether its `uses[]` is complete and genuinely expository. The human/agent half of the `uses` QA axis; the mechanical half runs in `qa-checkers-uses.ts`."
        }
      ],
      "skos:notation": "uses-editorial-review",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/uses-editorial-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/vocabulary-authority",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "vocabulary-authority"
        }
      ],
      "skos:definition": [
        {
          "@value": "One vocabulary is authoritative for one kind of fact, and every other is a derived rendering reached by a declared mapping. Which vocabulary owns what here, the pros and cons behind each ruling, how DC and SKOS overlap and what stops them drifting, and the normalisation-first rule for any modelling or mapping exercise."
        }
      ],
      "skos:notation": "vocabulary-authority",
      "dcterms:source": "cat-harness/skills/kg/kg-core/vocabulary-authority.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/web-apps",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "web-apps"
        }
      ],
      "skos:definition": [
        {
          "@value": "Interactive web apps as knowledge-graph content: a layer holds an app's source in a directory of kind `web-app` (one `web-app.json`), its UI strings go through the harness's translation process like any template, and the harness's `apps` visualiser (Tool `web-app-build`) builds it at publish and writes it to its own route with no site chrome, loaded only when a reader opens it. Read before adding an app to any layer, before writing a publish script for one (do not), and when an app's build or translations fail."
        }
      ],
      "skos:notation": "web-apps",
      "dcterms:source": "cat-harness/skills/ui/ui-core/web-apps.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/where-does-this-go",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "where-does-this-go"
        }
      ],
      "skos:definition": [
        {
          "@value": "The router for filing decisions. This repository answers \"where does this go?\" ten separate times; this says WHICH question you are asking, so an agent who does not know a rule exists can find it. One discriminating question per row, and the skill that owns the answer."
        }
      ],
      "skos:notation": "where-does-this-go",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/where-does-this-go.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/wireframe-design-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "wireframe-design-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Design a user interface (a page, a visualiser, a navbar) by the WireGen methodology: a written design intent, at least two mid-fidelity HTML candidates, each with a web AND a mobile layout, mechanical checks at both viewports, a blind per-criterion review, adjudication where reviewers disagree, and a recorded choice. Also how an EXISTING visualiser is wireframed as-is, so that every declared visualiser has a wireframe with a QA sidecar. Process: processes/ui/wireframe-design-review.bpmn. Called for Design use from CRDM (Process_CRDM_Requirements, Call_Wireframe) whenever a requirement changes a rendered surface, before anything is built."
        }
      ],
      "skos:notation": "wireframe-design-review",
      "dcterms:source": "cat-harness/skills/ui/ui-core/wireframe-design-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/wireframe-viewport-check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "wireframe-viewport-check"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render wireframe candidates at a web viewport (1280x800) and a mobile viewport (390x844), and record, per candidate and viewport, a pass or fail entry with a note for each mechanical criterion: renders, no-overflow, no-placeholder. Writes a screenshot per viewport beside the report. The mechanical step (step 3) of wireframe-design-review; a fail sends the candidate back to that skill's step 2."
        }
      ],
      "skos:notation": "wireframe-viewport-check",
      "dcterms:source": "cat-harness/skills/ui/ui-core/wireframe-viewport-check.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/work-context",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "work-context"
        }
      ],
      "skos:definition": [
        {
          "@value": "Keep a short note on the work you are doing — what you did, what you decided and why, what is left open — with the memory tools, so the next person or agent to pick the work up starts where you stopped. Read when you are handed a piece of work, and before you stop working on it."
        }
      ],
      "skos:notation": "work-context",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/work-context.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/workflow-state",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "workflow-state"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where a running process keeps what it knows, and which store answers which question. The three records a step may touch, the one it may not, what `<cat-harness.processes:bean op>` actually performs, and why an instance and a work item must be one answer rather than two."
        }
      ],
      "skos:notation": "workflow-state",
      "dcterms:source": "cat-harness/skills/process/workflow/workflow-state.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills/zero-trust-handover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "zero-trust-handover"
        }
      ],
      "skos:definition": [
        {
          "@value": "How this platform applies zero trust (the zero-trust-architecture methodology, NIST SP 800-207) to every hand-over between agents, skills, tools and graphs: rules H1-H9, the hand-over screen and where it is wired, the remote-mount trust gate, per-tool risk read from a tool's sinks, and the release security gate. A house application, not a methodology: read the node for the method, read this for what to do at a boundary."
        }
      ],
      "skos:notation": "zero-trust-handover",
      "dcterms:source": "cat-harness/skills/conduct/security/zero-trust-handover.md",
      "skos:note": "candidate"
    }
  ]
}
