    <bpmn:sequenceFlow id="F13" sourceRef="Task_SplitAnnexes" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Review" targetRef="GW_PublicComment" />
    <bpmn:sequenceFlow id="F15" name="yes" sourceRef="GW_PublicComment" targetRef="Call_PublicComment" />
    <bpmn:sequenceFlow id="F16" name="no" sourceRef="GW_PublicComment" targetRef="GW_CommentJoin" />
    <bpmn:sequenceFlow id="F17" sourceRef="Call_PublicComment" targetRef="GW_CommentJoin" />
    <bpmn:sequenceFlow id="F18" sourceRef="GW_CommentJoin" targetRef="GW_ReadyToSign" />
    <bpmn:sequenceFlow id="F19" name="changes needed" sourceRef="GW_ReadyToSign" targetRef="GW_DraftMerge" />
